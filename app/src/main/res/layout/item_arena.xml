<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/arena_card_width"
    android:layout_height="@dimen/arena_card_height"
    android:layout_marginEnd="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:text="@string/arena_tag"
        android:textAppearance="@style/TextAppearance.ClueRush.Caption"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/arenaName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.ClueRush.Headline"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/arenaSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:alpha="0.9"
        android:textAppearance="@style/TextAppearance.ClueRush.Caption"
        android:textColor="@color/white" />
</LinearLayout>