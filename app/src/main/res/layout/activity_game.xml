<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.ripti.cluerush.ui.view.VignetteView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.ripti.cluerush.ui.view.AvatarView
        android:id="@+id/avatarView"
        android:layout_width="@dimen/avatar_game_size"
        android:layout_height="@dimen/avatar_game_size"
        android:layout_gravity="center"
        android:contentDescription="@string/cd_player_avatar" />


    <FrameLayout
        android:id="@+id/hudLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/exitButton"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/hud_margin_small"
            android:background="@drawable/bg_hud_circle"
            android:contentDescription="@string/cd_exit_match"
            android:padding="@dimen/hud_icon_padding"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/hintBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/hud_margin_small"
            android:alpha="0"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:maxWidth="@dimen/hint_max_width"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.ClueRush.Body"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cluePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/hud_margin_small"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/panelToggle"
                android:layout_width="@dimen/panel_toggle_width"
                android:layout_height="@dimen/panel_toggle_height"
                android:background="@drawable/bg_hud_tab"
                android:contentDescription="@string/cd_toggle_clue_panel"
                android:src="@drawable/ic_chevron_right" />

            <LinearLayout
                android:id="@+id/clueCard"
                android:layout_width="@dimen/clue_panel_width"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_panel"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/clueIndexText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ClueRush.Caption"
                    android:textColor="@color/hud_text_secondary" />

                <TextView
                    android:id="@+id/clueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.ClueRush.Body"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/heatChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/heat_cold"
                    android:textAppearance="@style/TextAppearance.ClueRush.Caption"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.ripti.cluerush.ui.view.JoystickView
            android:id="@+id/joystick"
            android:layout_width="@dimen/joystick_size"
            android:layout_height="@dimen/joystick_size"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/hud_margin"
            android:layout_marginBottom="@dimen/hud_margin_small"
            android:contentDescription="@string/cd_joystick" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            style="@style/Widget.ClueRush.Button.Gold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/action_button_height"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/hud_margin"
            android:layout_marginBottom="@dimen/hud_margin_small"
            android:minWidth="@dimen/action_button_min_width"
            android:text="@string/action_is_this_the_place" />

        <TextView
            android:id="@+id/attributionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_hud_pill"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/osm_attribution"
            android:textColor="@color/white"
            android:textSize="@dimen/text_micro" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay_card"
            android:gravity="center_horizontal"
            android:minWidth="@dimen/result_card_min_width"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ClueRush.Headline"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/resultLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.ClueRush.Title"
                android:textColor="@color/treasure_gold" />

            <TextView
                android:id="@+id/resultBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:maxWidth="@dimen/result_body_max_width"
                android:textAppearance="@style/TextAppearance.ClueRush.Body"
                android:textColor="@color/hud_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resultButton"
                style="@style/Widget.ClueRush.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/action_continue" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>